<clickhouse>
    <logger>
        <!--
            Possible levels: ["none", "fatal", "critical", "error", "warning", "notice", "information", "debug", "trace", "test"]
            See: https://github.com/pocoproject/poco/blob/poco-1.9.4-release/Foundation/include/Poco/Logger.h#L105-L114
        -->
        <level>warning</level>
    </logger>
    <!-- RAM nội bộ ClickHouse: 2.25 GB -->
    <max_server_memory_usage>2415919104</max_server_memory_usage>
    <max_server_memory_usage_to_ram_ratio>0.80</max_server_memory_usage_to_ram_ratio>

    <!-- Cache -->
    <mark_cache_size>268435456</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>

    <!-- Giảm số truy vấn đồng thời -->
    <max_concurrent_queries>10</max_concurrent_queries>

    <!-- Giảm CPU dành cho merge/mutation nền -->
    <background_pool_size>2</background_pool_size>
    <background_merges_mutations_concurrency_ratio>1</background_merges_mutations_concurrency_ratio>

    <!-- Các tác vụ nền khác -->
    <background_schedule_pool_size>8</background_schedule_pool_size>
    <background_fetches_pool_size>2</background_fetches_pool_size>
    <background_move_pool_size>1</background_move_pool_size>
    
    <concurrent_threads_soft_limit_num>1</concurrent_threads_soft_limit_num>
    <profiles>
        <default>
        <max_block_size>8192</max_block_size>
        <max_download_threads>1</max_download_threads>
        <input_format_parallel_parsing>0</input_format_parallel_parsing>
        <output_format_parallel_formatting>0</output_format_parallel_formatting>
        <!-- Mỗi query tối đa 2 thread xử lý -->
        <max_threads>2</max_threads>

        <!-- Giảm thread dành cho xử lý INSERT -->
        <max_insert_threads>1</max_insert_threads>

        <!-- Tránh một query đơn lẻ chiếm quá nhiều CPU -->
        <max_final_threads>2</max_final_threads>
        </default>
    </profiles>
</clickhouse>
